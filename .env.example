# URL base de la API en producción (con HTTPS y el prefijo /api).
# Copia este archivo como .env y reemplaza el valor.
#
# Si la variable no está definida, la app usa la IP de la PC en la red local
# (http://<ip-de-la-pc>:8000/api), que sirve para desarrollar con Expo Go.
#
# Las variables EXPO_PUBLIC_* quedan dentro de la app compilada, así que aquí
# solo debe ir la URL pública, nunca claves secretas.
EXPO_PUBLIC_API_URL=https://cineteca-api-12771576319.us-central1.run.app/api

# APIs de los compañeros del grupo (URL base pública con https, sin barra final).
# Lester Esquivel - App de agenda de viajes (viajes completados / nuevo viaje)
EXPO_PUBLIC_VIAJES_API_URL=
# Jose Rodriguez - App para deportistas de Gym (perfiles / nuevo perfil)
EXPO_PUBLIC_PERFILES_API_URL=
